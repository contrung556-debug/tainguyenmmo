export default async function handler(req, res) {
  const realGasUrl = process.env.GAS_OTP_REAL; // Link Google Apps Script thật
  const { hide, callback } = req.query;

  try {
    const response = await fetch(`${realGasUrl}?hide=${encodeURIComponent(hide || '')}`);
    const textData = await response.text();

    res.setHeader('Access-Control-Allow-Origin', '*');

    if (callback) {
      // Trả về dạng JSONP cho script tag
      res.setHeader('Content-Type', 'application/javascript');
      res.status(200).send(`${callback}(${textData});`);
    } else {
      res.setHeader('Content-Type', 'application/json');
      res.status(200).send(textData);
    }
  } catch (error) {
    res.status(500).json({ status: 'error', message: error.message });
  }
}
