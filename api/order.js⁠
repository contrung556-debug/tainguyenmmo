export default async function handler(req, res) {
  const rawUrl = process.env.GAS_ORDER_URL;
  const { action, code, callback } = req.query;

  if (!rawUrl || !rawUrl.startsWith('http')) {
    return res.status(500).json({ 
      status: 'error', 
      message: 'GAS_ORDER_URL chưa được cấu hình đúng trên Vercel' 
    });
  }

  try {
    let targetUrl = `${rawUrl.trim()}?action=${encodeURIComponent(action || '')}&code=${encodeURIComponent(code || '')}`;
    if (callback) {
      targetUrl += `&callback=${encodeURIComponent(callback)}`;
    }

    const response = await fetch(targetUrl);
    const textData = await response.text();

    res.setHeader('Access-Control-Allow-Origin', '*');

    if (callback) {
      res.setHeader('Content-Type', 'application/javascript; charset=utf-8');
      return res.status(200).send(textData);
    } else {
      res.setHeader('Content-Type', 'application/json; charset=utf-8');
      return res.status(200).send(textData);
    }
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
}
