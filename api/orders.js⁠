export default async function handler(req, res) {
  // Đổi từ GAS_ORDER_REAL sang GAS_ORDER_URL để khớp trực tiếp với Vercel
  const realGasOrderUrl = process.env.GAS_ORDER_URL; 
  const { action, code, callback } = req.query;

  if (!realGasOrderUrl) {
    return res.status(500).json({ status: 'error', message: 'Chưa cấu hình biến môi trường GAS_ORDER_URL trên Vercel' });
  }

  try {
    let targetUrl = `${realGasOrderUrl}?action=${encodeURIComponent(action || '')}&code=${encodeURIComponent(code || '')}`;
    const response = await fetch(targetUrl);
    const textData = await response.text();

    res.setHeader('Access-Control-Allow-Origin', '*');

    if (callback) {
      res.setHeader('Content-Type', 'application/javascript');
      return res.status(200).send(`${callback}(${textData});`);
    } else {
      res.setHeader('Content-Type', 'application/json');
      return res.status(200).send(textData);
    }
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
}
